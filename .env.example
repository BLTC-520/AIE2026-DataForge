# DataForge env template — copy to .env.local and set the keys you need.
# Realtime pipeline: missing keys produce explicit stage errors, not silent
# fallbacks.

# OpenAI — covers BOTH analyze and evaluate stages
#   /api/quality-report   → structured repair plan (Analyze Gaps stage)
#   /api/evaluate-dataset → class-balance scoring (Evaluate / Re-evaluate stages)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Fal synthetic generation — required for Generate Synthetic Data stage
FAL_KEY=

# Convex (optional — used by the legacy demo dashboard for live persistence)
# Local dev defaults:
CONVEX_DEPLOYMENT=anonymous:anonymous-AIESG-May2026
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Cloud (hosted) example values:
# CONVEX_DEPLOYMENT=<your-deployment>
# NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site
